#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

git diff --cached --check --

biome_files=()
while IFS= read -r -d '' path; do
  case "$path" in
    *.ts|*.js|*.mjs|*.cjs|*.json)
      [ -f "$path" ] && biome_files+=("$path")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z --)

if [ ${#biome_files[@]} -gt 0 ]; then
  npm exec -- biome check --error-on-warnings --no-errors-on-unmatched -- "${biome_files[@]}"
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --redact --staged --verbose
else
  printf '%s\n' 'pre-commit: gitleaks not found; skipping secret scan' >&2
fi
